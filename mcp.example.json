{
  "url": "https://mcp.example.com/mcp",
  "header_env": {"x-workbench-api-key": "RELAY_WORKBENCH_API_KEY"},
  "repository": {
    "tool": "replace_with_repository_tool",
    "arguments": {"workspace": "$workspace", "repo": "$repo"},
    "result_path": "data"
  },
  "branches": {
    "tool": "replace_with_branches_tool",
    "arguments": {"workspace": "$workspace", "repo": "$repo", "cursor": "$cursor"},
    "result_path": "values",
    "cursor_path": "next"
  },
  "pipeline_file": {
    "tool": "replace_with_file_tool",
    "arguments": {"workspace": "$workspace", "repo": "$repo", "ref": "$branch", "path": "bitbucket-pipelines.yml"},
    "result_path": "content"
  }
}
